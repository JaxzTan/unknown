# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# One file for the whole repo: paths starting with backend/ or frontend/ are scoped to that app.

# ---------- shared ----------
.DS_Store
*.log
*.swp
*.pem
.history
node_modules/

# env files (secrets — never commit)
.env*
*.env

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder holds launch configs you may want to share, so it is not ignored.
#.vscode/

# ---------- backend (Next.js + Prisma) ----------
backend/.next/
backend/out/
backend/build/
backend/coverage/
backend/.vercel
backend/*.tsbuildinfo
backend/next-env.d.ts
backend/.pnp
backend/.pnp.*
backend/.yarn/*
!backend/.yarn/patches
!backend/.yarn/plugins
!backend/.yarn/releases
!backend/.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# prisma client (regenerated by `npm run db:generate`)
backend/src/generated/

# ---------- frontend (Flutter) ----------
*.class
*.pyc
.atom/
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
frontend/build/
frontend/coverage/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android Studio build artifacts
frontend/android/app/debug
frontend/android/app/profile
frontend/android/app/release
