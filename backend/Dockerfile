# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1

# ---- deps: install once, prisma client generated by postinstall ----
FROM base AS deps
# prisma.config.ts needs a URL to load; generate never connects to it
ENV DIRECT_URL=postgresql://build:build@localhost:5432/build
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

# ---- dev: source is synced in by `docker compose watch` ----
FROM deps AS dev
COPY . .
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]

# ---- build ----
FROM deps AS build
COPY . .
RUN npm run build

# ---- worker: shares the codebase, runs with tsx ----
FROM deps AS worker
ENV NODE_ENV=production
COPY . .
USER node
CMD ["npm", "run", "worker"]

# ---- api: minimal standalone Next.js server ----
# Kept last: hosts that build without a target (Railway) get the API by default
FROM base AS api
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
